{
  "name": "ai-restaurant-battle",
  "version": "2.0.0",
  "description": "AI Restaurant Battle - 3D competitive restaurant management game",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src test e2e",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"styles/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"styles/**/*.css\"",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "keywords": [
    "game",
    "ai",
    "restaurant",
    "management",
    "typescript",
    "threejs",
    "webaudio"
  ],
  "author": "AI Restaurant Battle Team",
  "license": "MIT",
  "dependencies": {
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
